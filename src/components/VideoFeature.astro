---
// The player is not loaded on page load. A local poster stands in until the
// visitor presses play, which keeps Croydon's homepage free of third-party
// requests and cookies unless somebody actually wants to watch.
interface Props {
  videoId: string;
  videoTitle: string;
  poster: string;
  posterAlt: string;
  eyebrow: string;
  heading: string;
  body: string[];
  href: string;
  linkText: string;
}
const { videoId, videoTitle, poster, posterAlt, eyebrow, heading, body, href, linkText } = Astro.props;
---

<section class="bg-paper border-y border-slate/15">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-brand">{eyebrow}</p>
    <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-ink text-center">{heading}</h2>

    <div
      class="player-shell relative mx-auto mt-9 w-full max-w-3xl overflow-hidden rounded-lg bg-ink shadow-lg"
      style="aspect-ratio: 16 / 9;"
      data-clip={videoId}
      data-clip-title={videoTitle}
    >
      <img
        src={poster}
        alt={posterAlt}
        width="900"
        height="506"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <button
        type="button"
        class="absolute inset-0 grid place-items-center bg-ink/25 hover:bg-ink/45 focus-visible:bg-ink/45 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand transition-colors"
        aria-label={`Play video: ${videoTitle}`}
      >
        <span class="grid h-16 w-16 sm:h-[4.5rem] sm:w-[4.5rem] place-items-center rounded-full bg-brand shadow-xl">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-8 w-8 text-white translate-x-0.5">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
    </div>

    <div class="mx-auto mt-8 max-w-2xl">
      {body.map((para) => <p class="mt-4 text-slate">{para}</p>)}
      <p class="mt-7 text-center">
        <a href={href} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white hover:bg-brand-light">
          {linkText}
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".player-shell").forEach((shell) => {
    const play = shell.querySelector("button");
    if (!play) return;
    play.addEventListener("click", () => {
      const el = document.createElement("iframe");
      el.src = `https://www.youtube-nocookie.com/embed/${shell.dataset.clip}?autoplay=1&rel=0`;
      el.title = shell.dataset.clipTitle || "Video";
      el.className = "absolute inset-0 h-full w-full";
      el.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      el.referrerPolicy = "strict-origin-when-cross-origin";
      el.allowFullscreen = true;
      shell.replaceChildren(el);
    });
  });
</script>
