---
import Layout from "./Layout.astro";
import { business, img } from "../data/business";
import { locations } from "../data/locations";
import { serviceLinks } from "./Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import StatsBar from "../components/StatsBar.astro";
import Reviews from "../components/Reviews.astro";
import Guarantee from "../components/Guarantee.astro";
import NextPage from "../components/NextPage.astro";
import type { LocationPageData } from "../data/locationPages";

interface Props { data: LocationPageData }
const { data } = Astro.props;

// Checked facts come from locations.ts so the council can never drift from
// what the rest of the site says.
const town = locations.find((l) => l.slug === data.slug)!;
const heroImg = img(data.heroPublicId, 1200);

// Steps two and five are written per town. The rest describe how the firm
// works, which does not change with the postcode.
const steps = [
  {
    h: "Ring, or send a photo",
    p: "A picture from the pavement or the back garden is often enough to tell whether this is a today job or one that can sensibly wait until next week.",
  },
  { h: "The free visit", p: data.processSurvey },
  {
    h: "What failed, and what let it",
    p: "Before any figure is mentioned you hear what has gone wrong and the reason it went, with photographs from the roof and from the loft side.",
  },
  {
    h: "A fixed price on paper",
    p: "Each item on its own line. Scaffold or a tower, if one is needed at all, sits separately so you can hold it up against anyone else's quote.",
  },
  { h: "The repair itself", p: data.processWork },
  {
    h: "Signed off",
    p: `Photographs of the finished work, gutters cleared of anything the job dropped into them, and the ${business.workmanshipGuaranteeYears} year guarantee in writing before anyone leaves ${data.name}.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: `Roof Repairs ${data.name}`, item: `${business.url}/${data.slug}` },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Roof Repairs in ${data.name}`,
  serviceType: "Roof Repairs",
  provider: { "@type": "RoofingContractor", name: business.name, url: business.url },
  areaServed: { "@type": "Place", name: `${data.name}, ${town.postcode}` },
};
---

<Layout
  title={data.metaTitle}
  description={data.metaDescription}
  heroImage={heroImg}
  ogImage={heroImg}
  schema={[faqSchema, breadcrumbSchema, serviceSchema]}
>
  <!-- Hero -->
  <section class="relative bg-ink text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate via-ink to-ink" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <nav aria-label="Breadcrumb" class="text-xs text-steel-light/60">
          <a href="/" class="hover:text-brand-light">Home</a>
          <span class="mx-2 text-steel">/</span>
          <span class="text-steel-light">Roof Repairs {data.name}</span>
        </nav>
        <p class="mt-4 inline-flex items-center rounded-full border border-brand/50 bg-brand/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-light">
          {data.name} · {town.postcode}
        </p>
        <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight leading-[1.08]">
          <a href="/" class="text-white hover:text-brand-light transition-colors">Roof Repairs In {data.name}</a>
        </h1>
        <h2 class="mt-4 text-xl font-semibold text-brand-light">{data.h2}</h2>
        <h3 class="mt-3 text-lg font-semibold text-steel-light">{data.h3}</h3>
        <p class="mt-6 text-lg text-steel-light">{data.intro}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={business.phoneHref} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
            Call {business.phone}
          </a>
          <a href="/contact" class="inline-flex items-center rounded-md border border-steel-light/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">
            Book A Free Look
          </a>
        </div>
      </div>
      <div>
        <img
          src={heroImg}
          alt={data.heroAlt}
          class="w-full rounded-xl shadow-2xl object-cover aspect-[4/3] ring-1 ring-white/10"
          width="1200" height="900" fetchpriority="high" loading="eager"
        />
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16">
      <ContactForm page={`Location: ${data.name}`} title={`Free roof survey in ${data.name}`} />
    </div>
  </section>

  <StatsBar />

  <!-- About the town -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="text-3xl sm:text-4xl font-bold text-ink rule">{data.about.h}</h2>
      <p class="mt-6 text-slate/80">{data.about.p1}</p>
      <p class="mt-4 text-slate/80">{data.about.p2}</p>
    </div>
    <div>
      <img src={img(data.about.publicId, 800)} alt={data.about.alt}
        class="w-full rounded-xl shadow-lg object-cover aspect-[4/3]" width="800" height="600" loading="lazy" />
    </div>
  </section>

  <!-- Featured services -->
  <section class="bg-white border-y border-slate/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Roof repairs {data.name} asks for most</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {data.featured.map((f) => (
          <a href={f.href} class="group rounded-xl border border-slate/15 bg-paper p-6 hover:border-brand transition-colors flex flex-col">
            <h3 class="text-lg font-bold text-ink group-hover:text-brand-dark">{f.name}</h3>
            <p class="mt-2 text-sm text-slate/80 flex-1">{f.text}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-dark">
              Read more<span aria-hidden="true">&rarr;</span>
              <span class="sr-only">about {f.name.toLowerCase()} in {data.name}</span>
            </span>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-slate/60">
        Those three come up most on {data.name} roofs. Everything else in the services menu is
        covered here as well.
      </p>
    </div>
  </section>

  <!-- Town benefits -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">{data.benefitsHeading}</h2>
    <p class="mt-8 text-center text-slate/70 max-w-3xl mx-auto">{data.benefitsIntro}</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {data.benefits.map((b) => (
        <div class="border-t-2 border-brand pt-5">
          <h3 class="text-base font-bold text-ink">{b.title}</h3>
          <p class="mt-2 text-sm text-slate/80">{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Insight stat -->
  <section class="bg-brand/5 border-y border-brand/20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 text-center">
      <p class="text-xl sm:text-2xl font-semibold text-ink leading-snug">"{data.insight}"</p>
      <p class="mt-4 text-sm text-slate/60">Based on {data.name} jobs handled by {business.name}</p>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-center rule rule-center">A roof repair in {data.name}, step by step</h2>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {steps.map((step, i) => (
          <div class="rounded-xl border border-steel bg-slate p-6">
            <div class="text-brand-light text-3xl font-bold">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="mt-2 text-lg font-semibold text-white">{step.h}</h3>
            <p class="mt-2 text-steel-light/80 text-sm">{step.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Guarantee />

  <!-- Things to do -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">What to do in {data.name}</h2>
    <p class="mt-8 text-center text-slate/70 max-w-3xl mx-auto">
      Nothing to do with roofs. Three places worth an afternoon if you live here or are thinking
      of moving in.
    </p>
    <div class="mt-10 grid sm:grid-cols-3 gap-6">
      {data.attractions.map((a) => (
        <div class="rounded-xl border border-slate/15 bg-white overflow-hidden shadow-sm flex flex-col">
          <img src={img(a.publicId, 600)} alt={a.alt} class="w-full object-cover aspect-[3/2]"
            width="600" height="400" loading="lazy" />
          <div class="p-5 flex flex-col flex-1">
            <h3 class="text-lg font-bold text-ink">{a.name}</h3>
            <p class="mt-2 text-sm text-slate/80 flex-1">{a.text}</p>
            <a href={a.mapLink} target="_blank" rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-dark hover:underline">
              View on Google Maps<span aria-hidden="true">&rarr;</span>
              <span class="sr-only">- {a.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Map -->
  <section class="bg-white border-y border-slate/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">Where {data.name} sits on our patch</h2>
      <p class="mt-6 text-center text-slate/70 max-w-3xl mx-auto">
        From our base on {business.address.street}, {business.address.postcode}: {town.driveTime}.
        Planning and building control here sit with {town.council}.
      </p>
      <div class="mt-8 rounded-xl overflow-hidden border border-slate/15 shadow-sm">
        <iframe
          src={`https://maps.google.com/maps?q=${encodeURIComponent(data.mapQuery)}&output=embed`}
          width="100%"
          height="400"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Map of ${data.name}`}
        ></iframe>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- Service area -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-ink">Other towns we cover, and what we do there</h2>
    <p class="mt-6 text-slate/70 max-w-3xl mx-auto">
      The same services and the same guarantee apply across every town below, from the Norbury
      end of the borough down to Caterham.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      <a href="/" class="rounded-full bg-ink px-4 py-1.5 text-sm font-semibold text-white hover:bg-slate">Croydon</a>
      {locations.map((l) => (
        l.slug === data.slug ? (
          <span class="rounded-full bg-brand px-4 py-1.5 text-sm font-semibold text-white" aria-current="page">{l.name}</span>
        ) : (
          <a href={`/${l.slug}`} class="rounded-full border border-slate/20 bg-white px-4 py-1.5 text-sm text-slate/80 hover:border-brand hover:text-brand-dark">{l.name}</a>
        )
      ))}
    </div>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      {serviceLinks.map((s) => (
        <a href={s.slug} class="rounded-full border border-brand/30 bg-brand/5 px-4 py-1.5 text-sm text-ink hover:border-brand hover:text-brand-dark">{s.name}</a>
      ))}
    </div>
  </section>

  <!-- Cost -->
  <section class="bg-slate text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">Roof repair costs in {data.name}</h2>
      <p class="mt-6 text-steel-light max-w-3xl mx-auto">{data.costText}</p>
      <a href="/roof-repair-cost" class="mt-8 inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
        Read the cost guide
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-3xl sm:text-4xl font-bold text-ink text-center rule rule-center">{data.name} roof repair questions</h2>
    <div class="mt-10 max-w-3xl mx-auto divide-y divide-slate/15">
      {data.faqs.map((faq) => (
        <div class="py-6">
          <h3 class="text-lg font-semibold text-ink">{faq.question}</h3>
          <p class="mt-2 text-slate/80">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">{data.finalH}</h2>
      <p class="mt-6 text-steel-light max-w-2xl mx-auto">{data.finalP}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={business.phoneHref} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white shadow-sm hover:bg-brand-light hover:text-ink">
          Call {business.phone}
        </a>
        <a href="/contact" class="inline-flex items-center rounded-md border border-steel-light/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">
          Book A Free Look
        </a>
      </div>
    </div>
  </section>

  <NextPage current={`/${data.slug}`} />
</Layout>
