---
import Layout, { serviceLinks } from "../layouts/Layout.astro";
import { business } from "../data/business";

const guidePages = [
  { name: "Common Roof Problems", slug: "/common-roof-problems" },
  { name: "Roof Repair Costs", slug: "/roof-repair-cost" },
  { name: "Blog", slug: "/blog" },
  { name: "Contact Us", slug: "/contact" },
];
---

<Layout
  title="Page Not Found | Roof Repairs Croydon"
  description="That address does not exist on this site. Use the links here to find the roofing service you were after, or ring Roof Repairs Croydon direct."
  noindex={true}
>
  <section class="bg-ink text-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-20">
        <p class="text-sm font-bold uppercase tracking-widest text-brand-light">Error 404</p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
          <a href="/" class="text-white hover:text-brand-light transition-colors">Nothing Sits At This Address</a>
        </h1>
        <h2 class="mt-4 text-xl font-semibold text-brand-light">Did a bookmark or a typed URL bring you here?</h2>
        <h3 class="mt-3 text-lg font-semibold text-steel-light">
          Either we renamed the page or it was never here - nothing has gone wrong at your end
        </h3>
        <p class="mt-6 text-steel-light">
          We tidy this site up now and again, so older links sometimes stop pointing anywhere. Pick
          the job you have got from the lists below and you will land in the right place. If water is
          coming in while you read this, skip the browsing and ring
          {" "}<a href={business.phoneHref} class="font-semibold text-white hover:text-brand-light">{business.phone}</a>.
        </p>

        <h2 class="mt-14 text-2xl font-bold tracking-tight">Roofing Work We Carry Out In Croydon</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {serviceLinks.map((s) => (
            <li>
              <a
                href={s.slug}
                class="block rounded-md border border-steel bg-slate px-4 py-3 font-semibold text-steel-light hover:border-brand hover:text-brand-light"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>

        <h2 class="mt-14 text-2xl font-bold tracking-tight">Reading, Prices And Getting Hold Of Us</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {guidePages.map((p) => (
            <li>
              <a
                href={p.slug}
                class="block rounded-md border border-steel bg-slate px-4 py-3 font-semibold text-steel-light hover:border-brand hover:text-brand-light"
              >
                {p.name}
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex flex-wrap gap-4">
          <a href={business.phoneHref} class="inline-flex items-center rounded-md bg-brand px-6 py-3 text-base font-bold text-white hover:bg-brand-light hover:text-ink">
            Call {business.phone}
          </a>
          <a href="/" class="inline-flex items-center rounded-md border border-steel-light/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">
            Start Again On The Homepage
          </a>
        </div>
      </div>
    </section>
</Layout>
