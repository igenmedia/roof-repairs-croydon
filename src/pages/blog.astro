---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business";
import NextPage from "../components/NextPage.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: business.url },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${business.url}/blog` },
  ],
};
---

<Layout
  title="Roofing Advice & Guides | Roof Repairs Croydon"
  description="Practical roofing guides written for Croydon homeowners - costs, leaks, storm damage, flat roofs and how to avoid paying for work you do not need."
  schema={[breadcrumbSchema]}
>
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16 text-center">
      <nav aria-label="Breadcrumb" class="text-xs text-steel-light/60">
        <a href="/" class="hover:text-brand-light">Home</a>
        <span class="mx-2 text-steel">/</span>
        <span class="text-steel-light">Blog</span>
      </nav>
      <h1 class="mt-4 text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
        <a href="/" class="text-white hover:text-brand-light transition-colors">Roofing Advice For Croydon Homeowners</a>
      </h1>
      <h2 class="mt-4 text-xl font-semibold text-brand-light">Worth reading before you spend anything</h2>
      <h3 class="mt-3 text-lg font-semibold text-steel-light">
        Guides to costs, leaks, storm damage and flat roofs, written for this borough rather than in general
      </h3>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    {posts.length === 0 ? (
      <p class="text-center text-slate/70">The first posts are on their way. In the meantime, the
        <a href="/common-roof-problems" class="text-brand-dark font-semibold hover:underline"> roof problems guide</a>
        covers most of what people ring up about.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class="group rounded-xl border border-slate/15 bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              class="w-full object-cover aspect-[3/2]"
              width="600" height="400"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
            <div class="p-5">
              <p class="text-xs text-slate/50">
                {post.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
              </p>
              <h2 class="mt-1 text-lg font-bold text-ink group-hover:text-brand-dark">{post.data.title}</h2>
              <p class="mt-2 text-sm text-slate/80">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  <NextPage current="/blog" />
</Layout>
